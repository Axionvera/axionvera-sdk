{
  "name": "@axionvera/core",
  "version": "2.0.0",
  "description": "Core SDK for Axionvera vaults, wallets, and Stellar/Soroban app integrations.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run clean && tsup"
  },
  "sideEffects": false,
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}

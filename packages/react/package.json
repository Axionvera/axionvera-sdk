{
  "name": "@axionvera/react",
  "version": "2.0.0",
  "description": "React hooks and provider for Axionvera SDK apps.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "npm run build --workspace=@axionvera/core && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run clean && tsup"
  },
  "peerDependencies": {
    "@axionvera/core": "*",
    "react": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

# Axionvera SDK Environment Variables Example
# Copy this file to .env and fill in real values for local development
# NEVER commit the .env file with real values to version control

# Network Configuration
AXIONVERA_NETWORK="testnet"
AXIONVERA_RPC_URL="https://soroban-testnet.stellar.org"
AXIONVERA_HORIZON_URL="https://horizon-testnet.stellar.org"
AXIONVERA_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract Configuration (Maintainer: Replace with real contract IDs)
VAULT_CONTRACT_ID="YOUR_CONTRACT_ID"

# RPC Configuration
AXIONVERA_TIMEOUT_MS="30000"
AXIONVERA_MAX_RETRIES="3"
AXIONVERA_RETRY_DELAY_MS="1000"

# Logging Configuration
AXIONVERA_LOG_LEVEL="info"

# Security: Never commit real values for the following variables
# Real contract IDs, API keys, or credentials should be managed securely
# Use environment-specific secret management for production deployments

{
  "name": "axionvera-sdk-monorepo",
  "version": "2.0.0",
  "description": "Clean TypeScript SDK for Axionvera vaults, wallets, and Stellar/Soroban app integrations.",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/axionvera/axionvera-sdk.git"
  },
  "scripts": {
    "clean": "rimraf packages/*/dist",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run typecheck && npm run build && vitest run",
    "release-readiness": "node scripts/release-readiness.js",
    "release-readiness:dry-run": "node scripts/release-readiness.js --dry-run",
    "test-release-readiness": "node scripts/test-release-readiness.js"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
